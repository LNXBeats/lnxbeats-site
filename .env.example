PORT=3000
NODE_ENV=development

# Stockage persistant en production (Railway : volume monté sur /data)
PERSISTENT_ROOT=/data

# PayPal REST API — créer une application sur developer.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Virement bancaire — renseigner avant d'activer ce mode
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Clé privée pour /admin.html (choisir une longue valeur aléatoire)
ADMIN_KEY=change-me-with-a-long-random-secret

# Notification e-mail
# L'adresse admin est déjà celle choisie pour recevoir les commandes.
ADMIN_EMAIL=lnx.beats.pro@gmail.com

# SMTP (à configurer pour les confirmations automatiques)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LNX Beats <lnx.beats.pro@gmail.com>"

# L'URL publique du site, utilisée dans les e-mails
# Domaine recommandé (à activer après enregistrement et DNS)
SITE_URL=https://lnxbeats.fr
