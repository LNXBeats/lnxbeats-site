# URL canonique publique utilisée par les metadata serveur.
SITE_URL=https://lnxbeats.fr

# Base PostgreSQL locale ou de développement uniquement.
# Remplacer chaque segment générique sans jamais commiter de credentials réels.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?schema=public

# Base jetable distincte, utile aux contrôles de migrations Prisma.
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE_SHADOW?schema=public

# Railway fournit PORT automatiquement. Cette valeur sert uniquement d'exemple local.
PORT=3000
