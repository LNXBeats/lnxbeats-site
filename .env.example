# URL canonique publique utilisée par les metadata serveur.
SITE_URL=https://lnxbeats.fr

# Origine exacte utilisée par l'authentification (sans chemin final).
AUTH_URL=http://localhost:3000

# Secret aléatoire d'au moins 32 octets. Générer une valeur distincte par environnement.
# Exemple de commande : openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Identité administrative approuvée. Cette adresse ne confère aucun droit :
# seul le rôle ADMIN persisté en base et attribué par le bootstrap local compte.
ADMIN_EMAIL=lnx.beats.pro@gmail.com
# ADMIN_BOOTSTRAP_CONFIRM=promote-verified-admin

# Portail de connexion QA strictement réservé au staging Railway. Les trois
# valeurs restent fermées par défaut ; le secret staging doit contenir au moins
# 32 caractères et ne doit jamais être commité.
AUTH_QA_ACCESS_ENABLED=false
AUTH_QA_ACCESS_CONFIRM=
AUTH_QA_ACCESS_SECRET=

# Transport d'authentification fail-closed par environnement. Development reste
# en capture ; Resend exige l'armement production documenté et des secrets serveur.
EMAIL_PROVIDER=capture
RESEND_API_KEY=
EMAIL_FROM=LNX Beats <notifications@example.invalid>
EMAIL_REPLY_TO=reply@example.invalid

# Les tests automatisés remplacent explicitement EMAIL_PROVIDER par capture.
# Aucun email réel n'est alors envoyé et seuls les destinataires QA autorisés passent.
AUTH_EMAIL_CAPTURE_PATH=/private/tmp/lnx-studio-v052-mailbox.jsonl

# Notifications transactionnelles V0.7.3. Development reste en capture ; Resend
# exige staging + confirmation explicite. Production et SMS réel restent fermés.
NOTIFICATION_DEPLOYMENT_ENV=development
NOTIFICATION_EMAIL_TRANSPORT=capture
EMAIL_NOTIFICATIONS_ENABLED=true
OWNER_EMAIL_NOTIFICATIONS_ENABLED=true
CLIENT_EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_OWNER_RECIPIENT=
APP_CANONICAL_URL=http://localhost:3000
NOTIFICATION_CAPTURE_PATH=/private/tmp/lnx-studio-v073-notifications.jsonl
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_SECRET=
RESEND_WEBHOOK_SECRET=
# Armement non secret exact réservé à une future activation production.
# NOTIFICATION_PRODUCTION_CONFIRM=I_UNDERSTAND_THIS_ENABLES_PRODUCTION_EMAILS
# RESEND_BASE_URL doit rester absent : l'adapter fixe https://api.resend.com.
# Harness Resend Railway staging uniquement. Laisser absent hors d'une QA humaine
# explicitement autorisée, puis retirer après les quatre scénarios.
# NOTIFICATION_STAGING_QA_CONFIRM=resend-v073-qa-approved
# Smoke test propriétaire réel staging one-shot. Laisser absent sauf pendant
# l'unique procédure humaine V0.7.3.2, puis retirer avec le destinataire.
# NOTIFICATION_OWNER_SMOKE_TEST_CONFIRM=I_UNDERSTAND_THIS_SENDS_ONE_REAL_OWNER_EMAIL
# Destinations staging autorisées, séparées par des virgules. Ne jamais ajouter
# de compte .invalid ; utiliser les adresses de test Resend ou une adresse validée.
NOTIFICATION_STAGING_RECIPIENT_ALLOWLIST=
# NOTIFICATION_STAGING_CONFIRM=resend-staging-approved
SMS_TRANSPORT=disabled
SMS_NOTIFICATIONS_ENABLED=false
SMS_OWNER_RECIPIENT=

# Paiements V0.7.4 : Stripe Test et PayPal Sandbox, tous deux fermés par défaut.
# Les secrets restent vides ici et sont fournis seulement par .env.local ignoré
# ou par le coffre de secrets de l'environnement. Aucune clé live n'est admise
# tant qu'une procédure de mise en production dédiée n'a pas été validée.
PAYMENTS_ENABLED=false
PAYMENT_DEPLOYMENT_ENV=development
STRIPE_PAYMENTS_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_PAYMENTS_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Confirmation non secrète obligatoire avant une QA sandbox sur Railway staging.
# PAYMENT_STAGING_CONFIRM=payments-staging-sandbox-approved
# Confirmations non secrètes, fournies uniquement lors des QA locales opt-in.
# STRIPE_DIAGNOSTIC_CONFIRM=
# PAYMENT_QA_CONFIRM=
# Facultatif : inutile pour Checkout hébergé, réservé à une future UI Elements.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Preview personnelle locale persistante (facultatif). Ces valeurs vont dans
# .env.local ignoré, jamais dans un fichier suivi.
# LNX_PREVIEW_MODE=persistent-local
# LNX_DATABASE_TARGET=lnx-studio-local-preview

# Base PostgreSQL locale ou de développement uniquement.
# Remplacer chaque segment générique sans jamais commiter de credentials réels.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE?schema=public

# Backend local de développement/preview. Les deux racines restent hors public/ et
# hors Git. Les anciens noms restent des alias temporaires compatibles.
MEDIA_STORAGE_DRIVER=local
MEDIA_DEPLOYMENT_ENV=local-preview
MEDIA_LOCAL_PUBLIC_ROOT=/ABSOLUTE/PRIVATE/PATH/lnx-studio/catalog-media
MEDIA_LOCAL_PRIVATE_ROOT=/ABSOLUTE/PRIVATE/PATH/lnx-studio/order-media
ORDER_UPLOAD_MODE=local-private
ORDER_UPLOAD_DIR=.private/order-uploads
MEDIA_STORAGE_ROOT=/ABSOLUTE/PRIVATE/PATH/lnx-studio/catalog-media

# Production objet S3-compatible (Cloudflare R2 recommandé). Créer deux buckets
# distincts et des identifiants distincts pour staging/production. Ne jamais
# commiter de vraie valeur dans ce fichier.
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_DEPLOYMENT_ENV=production
# MEDIA_STORAGE_PROVIDER=r2
# MEDIA_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BUCKET=lnx-studio-public-production
# MEDIA_PRIVATE_BUCKET=lnx-studio-private-production
# MEDIA_S3_FORCE_PATH_STYLE=false
# MEDIA_R2_STAGING_CONFIRM=
# MEDIA_R2_STAGING_RUNTIME_CONFIRM=
# MEDIA_R2_AUDIO_WAV_CONFIRM=
# MEDIA_MIGRATION_CONFIRM=
# MEDIA_MIGRATION_MAINTENANCE_CONFIRM=
# MEDIA_MIGRATION_DATABASE_CONFIRM=
# LNX_PRISMA_DEV_SERVER_FILE=/ABSOLUTE/PRIVATE/PATH/prisma-dev-server.json

# Base jetable distincte, utile aux contrôles de migrations Prisma.
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE_SHADOW?schema=public

# Railway fournit PORT automatiquement. Cette valeur sert uniquement d'exemple local.
PORT=3000
