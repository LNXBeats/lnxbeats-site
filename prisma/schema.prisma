model ShopReturnRequest {
  id                     String                     @id @default(uuid()) @db.Uuid
  requestNumber          String                     @unique @db.VarChar(32)
  shopOrderId            String                     @db.Uuid
  userId                 String                     @db.Uuid
  withdrawalRequestId    String?                    @unique @db.Uuid
  type                   ShopReturnRequestType
  status                 ShopReturnRequestStatus    @default(REQUESTED)
  customerComment        String?                    @db.VarChar(1000)
  adminComment           String?                    @db.VarChar(1000)
  physicalReturnRequired Boolean?
  returnCostDecision     ShopReturnCostDecision     @default(UNDECIDED)
  returnInstructions     String?                    @db.VarChar(2000)
  refundStatus           ShopReturnRefundStatus     @default(NOT_REQUESTED)
  itemsRefundCents       Int                        @default(0)
  shippingRefundCents    Int                        @default(0)
  totalRefundCents       Int                        @default(0)
  requestedAt            DateTime                   @default(now()) @db.Timestamptz(3)
  reviewedAt             DateTime?                  @db.Timestamptz(3)
  reviewedByUserId       String?                    @db.Uuid
  authorizedAt           DateTime?                  @db.Timestamptz(3)
  receivedAt             DateTime?                  @db.Timestamptz(3)
  inspectedAt            DateTime?                  @db.Timestamptz(3)
  refundRequestedAt      DateTime?                  @db.Timestamptz(3)
  refundedAt             DateTime?                  @db.Timestamptz(3)
  closedAt               DateTime?                  @db.Timestamptz(3)
  cancelledAt            DateTime?                  @db.Timestamptz(3)
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @db.Timestamptz(3)
  shopOrder              ShopOrder                  @relation(fields: [shopOrderId, userId], references: [id, userId], onDelete: Restrict)
  owner                  User                       @relation("ShopReturnOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy             User?                      @relation("ShopReturnReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  withdrawalRequest      ConsumerWithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
  items                  ShopReturnItem[]
  auditEvents            ShopReturnAuditEvent[]
  evidence               ShopReturnEvidence[]
  refundAttempt          RefundAttempt?
  creditNote             CreditNote?
  stockAdjustments       ProductStockAdjustment[]
  notifications          OrderNotification[]

  @@unique([id, shopOrderId])
  @@index([shopOrderId, requestedAt])
  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([reviewedByUserId])
  @@map("shop_return_requests")
}

model ShopReturnEvidence {
  id                  String                   @id @default(uuid()) @db.Uuid
  shopReturnRequestId String                   @db.Uuid
  uploaderUserId      String                   @db.Uuid
  originalName        String                   @db.VarChar(240)
  storageKey          String                   @unique @db.VarChar(500)
  mimeType            String                   @db.VarChar(80)
  byteSize            Int
  sha256              String                   @db.Char(64)
  status              ShopReturnEvidenceStatus @default(ACTIVE)
  uploadedAt          DateTime                 @default(now()) @db.Timestamptz(3)
  purgeDueAt          DateTime?                @db.Timestamptz(3)
  purgedAt            DateTime?                @db.Timestamptz(3)
  request             ShopReturnRequest        @relation(fields: [shopReturnRequestId], references: [id], onDelete: Restrict)

  @@unique([shopReturnRequestId, sha256])
  @@index([shopReturnRequestId, status])
  @@index([status, purgeDueAt])
  @@map("shop_return_evidence")
}

model ShopOrderCustomerRequest {
  id                  String                    @id @default(uuid()) @db.Uuid
  requestNumber       String                    @unique @db.VarChar(40)
