  sequenceNumber          BigInt                     @unique
  invoiceId               String                     @db.Uuid
  refundAttemptId         String?                    @unique @db.Uuid
  withdrawalRequestId     String?                    @db.Uuid
  shopReturnRequestId     String?                    @unique @db.Uuid
  idempotencyKey          String                     @unique @db.VarChar(255)
  issuedAt                DateTime                   @db.Timestamptz(3)
  amountCents             Int
  cumulativeCreditedCents Int
  remainingBalanceCents   Int
  currency                String                     @db.Char(3)
  reasonCode              CreditNoteReasonCode
  reasonText              String?                    @db.VarChar(500)
  snapshotHashSha256      String                     @unique @db.Char(64)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  invoice                 Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refundAttempt           RefundAttempt?             @relation(fields: [refundAttemptId], references: [id], onDelete: Restrict)
  withdrawalRequest       ConsumerWithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
  shopReturnRequest       ShopReturnRequest?         @relation(fields: [shopReturnRequestId], references: [id], onDelete: Restrict)
  auditEvents             BillingAuditEvent[]

  @@index([invoiceId, issuedAt])
  @@index([withdrawalRequestId])
  @@map("credit_notes")
}

model BillingAuditEvent {
  id           String             @id @default(uuid()) @db.Uuid
  invoiceId    String             @db.Uuid
  creditNoteId String?            @db.Uuid
  actorUserId  String?            @db.Uuid
  action       BillingAuditAction
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  invoice      Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNote   CreditNote?        @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  actor        User?              @relation("BillingAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
  @@index([creditNoteId, createdAt])
  @@index([actorUserId])
  @@map("billing_audit_events")
}

model ShopOrderItem {
  shopOrderId             String            @db.Uuid
  productId               String            @db.Uuid
  position                Int
  productTitle            String            @db.VarChar(240)
  inventoryTracked        Boolean
  unitPriceCents          Int
  quantity                Int
  lineTotalCents          Int
  shippingRequired        Boolean
  unitShippingCents       Int
  lineShippingCents       Int
