  id                    String               @id @default(uuid()) @db.Uuid
  previousVersionId     String?              @db.Uuid
  activatedVersionId    String               @db.Uuid
  actorAdminId          String?              @db.Uuid
  source                MusicPricingSource
  configurationRevision Int
  occurredAt            DateTime             @default(now()) @db.Timestamptz(3)
  previousVersion       MusicPricingVersion? @relation("MusicPricingActivationPreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  activatedVersion      MusicPricingVersion  @relation("MusicPricingActivationActivatedVersion", fields: [activatedVersionId], references: [id], onDelete: Restrict)
  actorAdmin            User?                @relation("MusicPricingActivationActor", fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([activatedVersionId, occurredAt])
  @@index([previousVersionId])
  @@index([actorAdminId])
  @@map("music_pricing_activations")
}

model Product {
  id                 String                   @id @default(uuid()) @db.Uuid
  slug               String                   @unique @db.VarChar(160)
  title              String                   @db.VarChar(240)
  description        String                   @db.Text
  status             ProductStatus            @default(DRAFT)
  priceCents         Int?
  currency           String                   @default("EUR") @db.VarChar(3)
  trackInventory     Boolean                  @default(false)
  stock              Int?
  shippingRequired   Boolean                  @default(false)
  shippingPriceCents Int                      @default(0)
  position           Int                      @default(0)
  publishedAt        DateTime?                @db.Timestamptz(3)
  archivedAt         DateTime?                @db.Timestamptz(3)
  lockVersion        Int                      @default(1)
  createdByAdminId   String?                  @db.Uuid
  updatedByAdminId   String?                  @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  createdByAdmin     User?                    @relation("ProductCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdmin     User?                    @relation("ProductUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  assets             ProductAsset[]
  stockAdjustments   ProductStockAdjustment[]
  auditEvents        ProductAuditEvent[]
  shopOrderItems     ShopOrderItem[]

  @@index([status, position, createdAt])
  @@index([createdByAdminId])
  @@index([updatedByAdminId])
  @@map("products")
}

model ProductAsset {
  productId String   @db.Uuid
  assetId   String   @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([productId, assetId])
  @@unique([productId, position])
  @@index([assetId])
  @@map("product_assets")
}

model ProductStockAdjustment {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  delta        Int
  stockBefore  Int
  stockAfter   Int
  reason       String   @db.VarChar(500)
  actorAdminId String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorAdmin   User?    @relation("ProductStockAdjustmentActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([actorAdminId])
  @@map("product_stock_adjustments")
}

model ProductAuditEvent {
  id           String             @id @default(uuid()) @db.Uuid
  productId    String             @db.Uuid
  action       ProductAuditAction
  actorAdminId String?            @db.Uuid
  metadata     Json               @default("{}")
  occurredAt   DateTime           @default(now()) @db.Timestamptz(3)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorAdmin   User?              @relation("ProductAuditEventActor", fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([productId, occurredAt])
  @@index([actorAdminId])
  @@map("product_audit_events")
}

model ShopOrder {
  id                       String                    @id @default(uuid()) @db.Uuid
  orderNumber              String                    @unique @db.VarChar(32)
  userId                   String                    @db.Uuid
  creationToken            String                    @db.Uuid
  requestFingerprintSha256 String                    @db.Char(64)
  status                   ShopOrderStatus           @default(OPEN)
  paymentStatus            ShopPaymentStatus         @default(AWAITING_PAYMENT)
  fulfillmentStatus        ShopFulfillmentStatus     @default(PENDING)
  currency                 String                    @default("EUR") @db.VarChar(3)
  subtotalCents            Int
  shippingCents            Int
  totalCents               Int
  shippingRequired         Boolean                   @default(false)
  shippingFirstName        String?                   @db.VarChar(100)
  shippingLastName         String?                   @db.VarChar(100)
  shippingAddressLine1     String?                   @db.VarChar(240)
  shippingAddressLine2     String?                   @db.VarChar(240)
  shippingPostalCode       String?                   @db.VarChar(32)
  shippingCity             String?                   @db.VarChar(120)
  shippingCountryCode      String?                   @db.Char(2)
  termsVersion             String?                   @db.VarChar(64)
  termsHashSha256          String?                   @db.Char(64)
  termsAcceptedAt          DateTime?                 @db.Timestamptz(3)
  reservationExpiresAt     DateTime                  @db.Timestamptz(3)
  paidAt                   DateTime?                 @db.Timestamptz(3)
  paymentReviewAt          DateTime?                 @db.Timestamptz(3)
  paymentReviewCode        String?                   @db.VarChar(80)
  preparingAt              DateTime?                 @db.Timestamptz(3)
  shippedAt                DateTime?                 @db.Timestamptz(3)
  shippingCarrier          String?                   @db.VarChar(120)
  trackingNumber           String?                   @db.VarChar(160)
  trackingUrl              String?                   @db.VarChar(1000)
  expiredAt                DateTime?                 @db.Timestamptz(3)
  cancelledAt              DateTime?                 @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  user                     User                      @relation("ShopOrderOwner", fields: [userId], references: [id], onDelete: Restrict)
  items                    ShopOrderItem[]
  events                   ShopOrderEvent[]
  lifecycleEvents          ShopOrderLifecycleEvent[]
  payments                 Payment[]
  notifications            OrderNotification[]

  @@unique([userId, creationToken])
  @@index([userId, createdAt])
  @@index([status, paymentStatus, reservationExpiresAt])
  @@index([fulfillmentStatus, createdAt])
  @@map("shop_orders")
}

model ShopOrderItem {
  shopOrderId       String            @db.Uuid
  productId         String            @db.Uuid
  position          Int
  productTitle      String            @db.VarChar(240)
  inventoryTracked  Boolean
  unitPriceCents    Int
  quantity          Int
  lineTotalCents    Int
  shippingRequired  Boolean
  unitShippingCents Int
  lineShippingCents Int
  currency          String            @default("EUR") @db.VarChar(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  shopOrder         ShopOrder         @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservation       StockReservation?

  @@id([shopOrderId, productId])
  @@unique([shopOrderId, productId, quantity])
  @@unique([shopOrderId, position])
  @@index([productId])
  @@map("shop_order_items")
}

model StockReservation {
  id          String                     @id @default(uuid()) @db.Uuid
  shopOrderId String                     @db.Uuid
  productId   String                     @db.Uuid
  quantity    Int
  status      ShopStockReservationStatus @default(ACTIVE)
  expiresAt   DateTime                   @db.Timestamptz(3)
  confirmedAt DateTime?                  @db.Timestamptz(3)
  releasedAt  DateTime?                  @db.Timestamptz(3)
  expiredAt   DateTime?                  @db.Timestamptz(3)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  item        ShopOrderItem              @relation(fields: [shopOrderId, productId, quantity], references: [shopOrderId, productId, quantity], onDelete: Restrict)
  events      ShopOrderEvent[]

  @@unique([shopOrderId, productId])
  @@unique([shopOrderId, productId, quantity])
  @@index([productId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

model ShopOrderEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  shopOrderId        String             @db.Uuid
  stockReservationId String?            @db.Uuid
  type               ShopOrderEventType
  actorUserId        String?            @db.Uuid
  metadata           Json               @default("{}")
  occurredAt         DateTime           @default(now()) @db.Timestamptz(3)
  shopOrder          ShopOrder          @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  stockReservation   StockReservation?  @relation(fields: [stockReservationId], references: [id], onDelete: Restrict)
  actor              User?              @relation("ShopOrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopOrderId, occurredAt])
  @@index([stockReservationId, occurredAt])
  @@index([actorUserId])
  @@map("shop_order_events")
}

model ShopOrderLifecycleEvent {
  id             String                      @id @default(uuid()) @db.Uuid
  shopOrderId    String                      @db.Uuid
  paymentId      String?                     @db.Uuid
  type           ShopOrderLifecycleEventType
  idempotencyKey String                      @unique @db.VarChar(255)
  actorUserId    String?                     @db.Uuid
  metadata       Json                        @default("{}")
  occurredAt     DateTime                    @default(now()) @db.Timestamptz(3)
  shopOrder      ShopOrder                   @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  payment        Payment?                    @relation("ShopOrderLifecycleEventPayment", fields: [paymentId, shopOrderId], references: [id, shopOrderId], onDelete: Restrict)
  actor          User?                       @relation("ShopOrderLifecycleEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopOrderId, occurredAt])
  @@index([paymentId, occurredAt])
  @@index([actorUserId])
  @@map("shop_order_lifecycle_events")
}
