model ContractDocument {
  id                   String                 @id @default(uuid()) @db.Uuid
  contractNumber       String                 @unique @db.VarChar(32)
  rightsRequestId      String                 @db.Uuid
  templateId           String                 @db.Uuid
  templateVersion      Int
  documentVersion      Int
  kind                 ContractDocumentKind
  status               ContractDocumentStatus @default(DRAFT)
  generatedAt          DateTime               @db.Timestamptz(3)
  acceptedAt           DateTime?              @db.Timestamptz(3)
  adminAcceptedAt      DateTime?              @db.Timestamptz(3)
  activatedAt          DateTime?              @db.Timestamptz(3)
  priceSnapshotCents   Int
  currency             String                 @db.VarChar(3)
  sourceSnapshot       Json
  documentHashSha256   String                 @db.VarChar(64)
  assetId              String                 @unique @db.Uuid
  retentionUntil       DateTime?              @db.Timestamptz(3)
  supersedesDocumentId String?                @unique @db.Uuid
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  request              RightsRequest          @relation(fields: [rightsRequestId], references: [id], onDelete: Restrict)
  template             ContractTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  asset                Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  supersedes           ContractDocument?      @relation("ContractDocumentVersions", fields: [supersedesDocumentId], references: [id], onDelete: Restrict)
  supersededBy         ContractDocument?      @relation("ContractDocumentVersions")
  acceptances          ContractAcceptance[]

  @@unique([rightsRequestId, kind, documentVersion])
  @@index([rightsRequestId, createdAt])
  @@index([templateId])
  @@index([status, generatedAt])
  @@map("contract_documents")
}

