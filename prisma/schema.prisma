model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  email                        String                      @unique @db.VarChar(320)
  emailVerified                Boolean                     @default(false)
  emailVerifiedAt              DateTime?                   @db.Timestamptz(3)
  displayName                  String                      @default("") @db.VarChar(120)
  firstName                    String?                     @db.VarChar(100)
  lastName                     String?                     @db.VarChar(100)
  image                        String?                     @db.VarChar(500)
  role                         UserRole                    @default(MEMBER)
  status                       UserStatus                  @default(PENDING)
  createdAt                    DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                    @updatedAt @db.Timestamptz(3)
  customerProfile              Customer?
  orders                       Order[]                     @relation("OrderAccount")
  orderEvents                  OrderEvent[]                @relation("OrderEventActor")
  confidenceReviews            ConfidenceAnnotation[]      @relation("ConfidenceReviewer")
  favorites                    Favorite[]
  sessions                     Session[]
  accounts                     Account[]
  rightsRequests               RightsRequest[]             @relation("RightsRequestOwner")
  partyConfirmations           ContractPartySnapshot[]     @relation("ContractPartyConfirmedBy")
  rightsEvents                 RightsRequestEvent[]        @relation("RightsEventActor")
  rightsMessages               RightsMessage[]             @relation("RightsMessageAuthor")
  templateApprovals            ContractTemplate[]          @relation("ContractTemplateApprover")
  contractAcceptances          ContractAcceptance[]        @relation("ContractAcceptanceActor")
  splitProposals               RightsSplitProposal[]       @relation("RightsSplitProposer")
  notificationEvents           NotificationEvent[]         @relation("NotificationEventActor")
  refundRequests               RefundAttempt[]             @relation("RefundRequestedBy")
  paymentAuditEvents           PaymentAuditEvent[]         @relation("PaymentAuditActor")
  pricingVersionsCreated       MusicPricingVersion[]       @relation("MusicPricingVersionCreatedBy")
  pricingConfigurationsUpdated MusicPricingConfiguration[] @relation("MusicPricingConfigurationUpdatedBy")
  pricingActivations           MusicPricingActivation[]    @relation("MusicPricingActivationActor")
  productsCreated              Product[]                   @relation("ProductCreatedBy")
  productsUpdated              Product[]                   @relation("ProductUpdatedBy")
  productStockAdjustments      ProductStockAdjustment[]    @relation("ProductStockAdjustmentActor")
  productAuditEvents           ProductAuditEvent[]         @relation("ProductAuditEventActor")
  shopOrders                   ShopOrder[]                 @relation("ShopOrderOwner")
  shopOrderEvents              ShopOrderEvent[]            @relation("ShopOrderEventActor")
  shopOrderLifecycleEvents     ShopOrderLifecycleEvent[]   @relation("ShopOrderLifecycleEventActor")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(120)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(500)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @unique @db.VarChar(320)
  value      String   @db.VarChar(500)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model RegistrationAttempt {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @db.VarChar(320)
  codeHash              String    @db.VarChar(128)
  expiresAt             DateTime  @db.Timestamptz(3)
  failedAttempts        Int       @default(0)
  resendCount           Int       @default(0)
  verifiedAt            DateTime? @db.Timestamptz(3)
  consumedAt            DateTime? @db.Timestamptz(3)
  continuationHash      String?   @db.VarChar(128)
  continuationExpiresAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([continuationExpiresAt])
  @@map("auth_registration_attempts")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @db.Uuid
  email       String   @unique @db.VarChar(320)
  displayName String?  @db.VarChar(120)
  firstName   String?  @db.VarChar(100)
  lastName    String?  @db.VarChar(100)
  phone       String?  @db.VarChar(40)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([createdAt])
  @@map("customers")
}

model Project {
  id                    String                   @id @default(uuid()) @db.Uuid
  slug                  String                   @unique @db.VarChar(160)
  title                 String                   @db.VarChar(240)
  subtitle              String?                  @db.VarChar(240)
  type                  ProjectType
  status                ProjectStatus            @default(DRAFT)
  publicVisible         Boolean                  @default(true)
  jukeboxPlacement      ProjectJukeboxPlacement?
  jukeboxPosition       Int?
  catalogPosition       Int                      @unique
  highlighted           Boolean                  @default(false)
  shortDescription      String?                  @db.Text
  description           String?                  @db.Text
  releaseDate           DateTime?                @db.Date
  featured              Boolean                  @default(false)
  trackCount            Int?
  artworkTone           String                   @default("graphite") @db.VarChar(32)
  seoTitle              String?                  @db.VarChar(240)
  seoDescription        String?                  @db.Text
  legacySourceVersion   String?                  @db.VarChar(80)
  confidence            DataConfidence           @default(UNKNOWN)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  tracks                Track[]
  platformLinks         PlatformLink[]
  credits               Credit[]
  confidenceAnnotations ConfidenceAnnotation[]
  assets                ProjectAsset[]
  favorites             Favorite[]

  @@index([status, featured])
  @@index([type, status])
  @@index([publicVisible, status, catalogPosition])
  @@index([publicVisible, jukeboxPlacement, jukeboxPosition, catalogPosition])
  @@map("projects")
}

model Track {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  position        Int
  title           String         @db.VarChar(240)
  durationSeconds Int?
  status          TrackStatus    @default(DRAFT)
  confidence      DataConfidence @default(UNKNOWN)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  credits         Credit[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("tracks")
}

model PlatformLink {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String?        @db.Uuid
  platform   Platform
  scope      PlatformScope
  url        String         @unique @db.Text
  label      String?        @db.VarChar(180)
  position   Int            @default(0)
  confidence DataConfidence @default(UNKNOWN)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, platform, scope])
  @@index([projectId, scope, position])
  @@map("platform_links")
}

model Credit {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String?        @db.Uuid
  trackId    String?        @db.Uuid
  name       String         @db.VarChar(180)
  role       CreditRole
  note       String?        @db.Text
  position   Int            @default(0)
  confidence DataConfidence @default(UNKNOWN)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  track      Track?         @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([projectId, position])
  @@index([trackId, position])
  @@map("credits")
}

model ConfidenceAnnotation {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  domain       ConfidenceDomain
  level        DataConfidence
  source       String?          @db.VarChar(500)
  note         String?          @db.Text
  verifiedAt   DateTime?        @db.Timestamptz(3)
  verifiedById String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  verifiedBy   User?            @relation("ConfidenceReviewer", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([projectId, domain])
  @@index([verifiedById])
  @@map("confidence_annotations")
}

model Asset {
  id                String              @id @default(uuid()) @db.Uuid
  type              AssetType
  storageKey        String              @unique @db.VarChar(500)
  storageBackend    MediaStorageBackend @default(LOCAL)
  storageProvider   String              @default("local") @db.VarChar(80)
  visibility        MediaVisibility     @default(PRIVATE)
  checksumSha256    String?             @db.VarChar(64)
  filename          String              @db.VarChar(255)
  mimeType          String              @db.VarChar(160)
  sizeBytes         BigInt
  width             Int?
  height            Int?
  durationMs        Int?                @map("duration_ms")
  alt               String?             @db.VarChar(500)
  rightsStatus      RightsStatus        @default(UNKNOWN)
  rightsNote        String?             @db.Text
  confidence        DataConfidence      @default(UNKNOWN)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  projects          ProjectAsset[]
  orders            OrderAsset[]
  contractDocuments ContractDocument[]
  products          ProductAsset[]

  @@index([type, rightsStatus])
  @@index([storageBackend, visibility])
  @@map("assets")
}

model ProjectAsset {
  projectId String           @db.Uuid
  assetId   String           @db.Uuid
  role      ProjectAssetRole
  position  Int              @default(0)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([projectId, assetId, role])
  @@index([projectId, role, position])
  @@index([assetId])
  @@map("project_assets")
}

model Order {
  id                         String                   @id @default(uuid()) @db.Uuid
  orderNumber                String                   @unique @db.VarChar(32)
  userId                     String?                  @db.Uuid
  customerId                 String?                  @db.Uuid
  customerEmail              String                   @db.VarChar(320)
  customerName               String?                  @db.VarChar(200)
  status                     OrderStatus              @default(DRAFT)
  title                      String?                  @db.VarChar(240)
  recipient                  String?                  @db.VarChar(200)
  occasion                   String?                  @db.VarChar(200)
  brief                      String                   @db.Text
  musicalDirection           String?                  @db.Text
  emotion                    String?                  @db.Text
  importantDetails           String?                  @db.Text
  wordsToInclude             String?                  @db.Text
  avoid                      String?                  @db.Text
  pronunciationNotes         String?                  @db.Text
  illustrationFormat         OrderIllustrationFormat?
  illustrationFormatCustom   String?                  @db.VarChar(240)
  notes                      String?                  @db.Text
  usage                      OrderUsage               @default(PERSONAL)
  coverIncluded              Boolean                  @default(false)
  priorityProcessing         Boolean                  @default(false)
  basePriceCents             Int                      @default(5000)
  coverPriceCents            Int                      @default(0)
  priorityPriceCents         Int                      @default(0)
  totalCents                 Int                      @default(5000)
  currency                   String                   @default("EUR") @db.VarChar(3)
  pricingVersion             String                   @default("2026-08-v1") @db.VarChar(32)
  personalUseTermsVersion    String?                  @db.VarChar(48)
  personalUseTermsHashSha256 String?                  @db.VarChar(64)
  personalUseTermsAcceptedAt DateTime?                @db.Timestamptz(3)
  contractRequired           Boolean                  @default(false)
  revisionAllowance          Int                      @default(1)
  revisionUsed               Int                      @default(0)
  submittedAt                DateTime?                @db.Timestamptz(3)
  serviceStartedAt           DateTime?                @db.Timestamptz(3)
  deliveredAt                DateTime?                @db.Timestamptz(3)
  downloadExpiresAt          DateTime?                @db.Timestamptz(3)
  cancelledAt                DateTime?                @db.Timestamptz(3)
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(3)
  account                    User?                    @relation("OrderAccount", fields: [userId], references: [id], onDelete: SetNull)
  customer                   Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events                     OrderEvent[]
  assets                     OrderAsset[]
  rightsRequests             RightsRequest[]
  commercialLicenses         CommercialLicense[]
  payments                   Payment[]
  notifications              OrderNotification[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([userId, status, updatedAt])
  @@index([customerId])
  @@map("orders")
}

model OrderNotification {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String?               @db.Uuid
  shopOrderId           String?               @db.Uuid
  kind                  OrderNotificationKind
  channel               NotificationChannel
