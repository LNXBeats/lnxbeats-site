generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProjectType {
  ALBUM
  SINGLE
  PROJECT
}

enum ProjectStatus {
  DRAFT
  IN_DEVELOPMENT
  PUBLISHED
  ARCHIVED
}

enum ProjectJukeboxPlacement {
  PUBLISHED
  DEVELOPMENT
}

enum TrackStatus {
  DRAFT
  ANNOUNCED
  RELEASED
  UNLISTED
}

enum Platform {
  SPOTIFY
  APPLE_MUSIC
  DEEZER
  YOUTUBE
  AMAZON_MUSIC
  DISTROKID
  ETSY
  OTHER
}

enum PlatformScope {
  ARTIST
  RELEASE
  STORE
}

enum CreditRole {
  ARTIST
  WRITER
  COMPOSER
  PRODUCER
  FEATURING
  ENGINEER
  OTHER
}

enum DataConfidence {
  CONFIRMED
  PARTIAL
  PLACEHOLDER
  UNKNOWN
}

enum ConfidenceDomain {
  OVERALL
  IDENTITY
  EDITORIAL
  RELEASE
  ARTWORK
  TRACKLIST
  PLATFORMS
  GENRES
  CREDITS
  SEO
}

enum AssetType {
  COVER
  AUDIO_PREVIEW
  HERO
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
  OTHER
}

enum RightsStatus {
  UNKNOWN
  PENDING
  CLEARED
  RESTRICTED
}

enum MediaStorageBackend {
  LOCAL
  OBJECT
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectAssetRole {
  COVER
  AUDIO_PREVIEW
  HERO
  GALLERY
  AUDIO
  DOCUMENT
  VIDEO
}

enum OrderAssetRole {
  REFERENCE
  DELIVERY
  DOCUMENT
  CONTRACT
}

enum OrderNotificationKind {
  OWNER_NEW_ORDER
  CUSTOMER_PAYMENT_CONFIRMED
  CUSTOMER_ORDER_ACCEPTED
  CUSTOMER_CREATION_STARTED
  CUSTOMER_DELIVERY_READY
  OWNER_RIGHTS_REQUESTED
  CUSTOMER_RIGHTS_INFORMATION_REQUIRED
  CUSTOMER_RIGHTS_PREAUTHORIZATION_READY
  CUSTOMER_RIGHTS_CONTRACT_READY
  OWNER_RIGHTS_CLIENT_ACCEPTED
  CUSTOMER_RIGHTS_REJECTED
  CUSTOMER_RIGHTS_READY_FOR_PAYMENT
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  FAILED_RETRYABLE
  FAILED_FINAL
  BOUNCED
  COMPLAINED
  SUPPRESSED
  CANCELED
}

enum NotificationProvider {
  CAPTURE
  RESEND
}

enum NotificationPriority {
  CRITICAL
  INFORMATIONAL
  INTERNAL
}

enum NotificationEventOutcome {
  PROCESSED
  IGNORED
  REQUIRES_REVIEW
}

enum NotificationSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  PROVIDER_SUPPRESSED
  MANUAL
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  RECEIVED
  SUBMITTED
  REVIEWING
  ACCEPTED
  IN_PROGRESS
  FIRST_VERSION_READY
  REVISION_REQUESTED
  FINALIZING
  DELIVERED
  REFUSED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum OrderUsage {
  PERSONAL
  COMMERCIAL_EXTENDED
}

enum OrderEventVisibility {
  CLIENT
  INTERNAL
}

enum RightsRequestType {
  PUBLICATION_LICENSE
  EXPLOITATION_PARTNERSHIP
}

enum RightsRequestStatus {
  DRAFT
  SUBMITTED
  INFORMATION_REQUIRED
  UNDER_REVIEW
  PREAUTHORIZATION_GENERATED
  CONTRACT_PREPARATION
  CONTRACT_READY
  CLIENT_ACCEPTED
  ADMIN_VALIDATED
  READY_FOR_PAYMENT
  REJECTED
  CANCELLED
  ACTIVE
}

enum ContractPartyType {
  INDIVIDUAL
  SOLE_PROPRIETOR
  COMPANY
  ASSOCIATION_OR_OTHER
}

enum RightsContributionKind {
  NONE
  STORY_BRIEF_ONLY
  LYRICS_FULL
  LYRICS_PARTIAL
  LYRICS_CO_WRITTEN
  MELODY
  MUSICAL_COMPOSITION
  ARRANGEMENT
  INSTRUMENTAL
  ARTISTIC_DIRECTION
  VOICE
  MIX_MASTER
  INSTRUMENTS
  PRODUCTION
  OTHER
}

enum AiContributionAssessment {
  NOT_REVIEWED
  HUMAN_CONTRIBUTION_DOCUMENTED
  LEGAL_REVIEW_REQUIRED
  DECLARATION_NOT_RECOMMENDED
  POTENTIALLY_ELIGIBLE
}

enum RightsGrantKind {
  PUBLICATION
  DISTRIBUTION
  PUBLIC_COMMUNICATION
  REPRODUCTION
  MONETIZATION
  ADAPTATION
  ADVERTISING
  AUDIOVISUAL_SYNCHRONIZATION
  CONTENT_ID
  SUBLICENSE
  CREDIT
  OTHER
}

enum ContractTemplateType {
  PUBLICATION_LICENSE
  EXPLOITATION_PARTNERSHIP
  SACEM_PREPARATION
}

enum ContractTemplateStatus {
  DRAFT
  AWAITING_LEGAL_REVIEW
  APPROVED
  RETIRED
}

enum ContractDocumentKind {
  PREAUTHORIZATION
  CONTRACT
  ACCEPTANCE_RECEIPT
  SACEM_PREPARATION
}

enum ContractDocumentStatus {
  DRAFT
  READY_FOR_CLIENT
  CLIENT_ACCEPTED
  ADMIN_VALIDATED
  SUPERSEDED
  ACTIVE
}

enum ContractAcceptanceKind {
  CLIENT
  ADMIN
}

enum RightsEventType {
  REQUEST_CREATED
  CONTACT_CONFIRMED
  REQUEST_SUBMITTED
  INFORMATION_REQUESTED
  INFORMATION_PROVIDED
  REVIEW_STARTED
  PREAUTHORIZATION_GENERATED
  CONTRACT_PARAMETERS_UPDATED
  DOCUMENT_GENERATED
  DOCUMENT_SUPERSEDED
  DOCUMENT_VIEWED
  CLIENT_ACCEPTED
  ADMIN_VALIDATED
  READY_FOR_PAYMENT
  REQUEST_REJECTED
  REQUEST_CANCELLED
}

enum RightsMessageKind {
  ADMIN_REQUEST
  CLIENT_RESPONSE
}

// Legacy V0.6 compatibility only. V0.7.2 uses RightsRequest.
enum CommercialLicenseStatus {
  REQUESTED
  CONTRACT_PENDING
  PAYMENT_PENDING
  ACTIVE
  REJECTED
  CANCELLED
}

enum CommercialLicensePaymentStatus {
  NOT_STARTED
  PENDING
  CONFIRMED
  REFUND_PENDING
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentMode {
  TEST
  LIVE
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  REQUIRES_REVIEW
}

enum PaymentMethod {
  CARD
  PAYPAL
  WERO
  OTHER
}

enum ProviderEventOutcome {
  PROCESSED
  IGNORED
  REQUIRES_REVIEW
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  email               String                  @unique @db.VarChar(320)
  emailVerified       Boolean                 @default(false)
  emailVerifiedAt     DateTime?               @db.Timestamptz(3)
  displayName         String                  @default("") @db.VarChar(120)
  firstName           String?                 @db.VarChar(100)
  lastName            String?                 @db.VarChar(100)
  image               String?                 @db.VarChar(500)
  role                UserRole                @default(MEMBER)
  status              UserStatus              @default(PENDING)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  customerProfile     Customer?
  orders              Order[]                 @relation("OrderAccount")
  orderEvents         OrderEvent[]            @relation("OrderEventActor")
  confidenceReviews   ConfidenceAnnotation[]  @relation("ConfidenceReviewer")
  favorites           Favorite[]
  sessions            Session[]
  accounts            Account[]
  rightsRequests      RightsRequest[]         @relation("RightsRequestOwner")
  partyConfirmations  ContractPartySnapshot[] @relation("ContractPartyConfirmedBy")
  rightsEvents        RightsRequestEvent[]    @relation("RightsEventActor")
  rightsMessages      RightsMessage[]         @relation("RightsMessageAuthor")
  templateApprovals   ContractTemplate[]      @relation("ContractTemplateApprover")
  contractAcceptances ContractAcceptance[]    @relation("ContractAcceptanceActor")
  splitProposals      RightsSplitProposal[]   @relation("RightsSplitProposer")
  notificationEvents  NotificationEvent[]     @relation("NotificationEventActor")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(120)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(500)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @unique @db.VarChar(320)
  value      String   @db.VarChar(500)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model RegistrationAttempt {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @db.VarChar(320)
  codeHash              String    @db.VarChar(128)
  expiresAt             DateTime  @db.Timestamptz(3)
  failedAttempts        Int       @default(0)
  resendCount           Int       @default(0)
  verifiedAt            DateTime? @db.Timestamptz(3)
  consumedAt            DateTime? @db.Timestamptz(3)
  continuationHash      String?   @db.VarChar(128)
  continuationExpiresAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([continuationExpiresAt])
  @@map("auth_registration_attempts")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @db.Uuid
  email       String   @unique @db.VarChar(320)
  displayName String?  @db.VarChar(120)
  firstName   String?  @db.VarChar(100)
  lastName    String?  @db.VarChar(100)
  phone       String?  @db.VarChar(40)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([createdAt])
  @@map("customers")
}

model Project {
  id                    String                   @id @default(uuid()) @db.Uuid
  slug                  String                   @unique @db.VarChar(160)
  title                 String                   @db.VarChar(240)
  subtitle              String?                  @db.VarChar(240)
  type                  ProjectType
  status                ProjectStatus            @default(DRAFT)
  publicVisible         Boolean                  @default(true)
  jukeboxPlacement      ProjectJukeboxPlacement?
  jukeboxPosition       Int?
  catalogPosition       Int                      @unique
  highlighted           Boolean                  @default(false)
  shortDescription      String?                  @db.Text
  description           String?                  @db.Text
  releaseDate           DateTime?                @db.Date
  featured              Boolean                  @default(false)
  trackCount            Int?
  artworkTone           String                   @default("graphite") @db.VarChar(32)
  seoTitle              String?                  @db.VarChar(240)
  seoDescription        String?                  @db.Text
  legacySourceVersion   String?                  @db.VarChar(80)
  confidence            DataConfidence           @default(UNKNOWN)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  tracks                Track[]
  platformLinks         PlatformLink[]
  credits               Credit[]
  confidenceAnnotations ConfidenceAnnotation[]
  assets                ProjectAsset[]
  favorites             Favorite[]

  @@index([status, featured])
  @@index([type, status])
  @@index([publicVisible, status, catalogPosition])
  @@index([publicVisible, jukeboxPlacement, jukeboxPosition, catalogPosition])
  @@map("projects")
}

model Track {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  position        Int
  title           String         @db.VarChar(240)
  durationSeconds Int?
  status          TrackStatus    @default(DRAFT)
  confidence      DataConfidence @default(UNKNOWN)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  credits         Credit[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("tracks")
}

model PlatformLink {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String?        @db.Uuid
  platform   Platform
  scope      PlatformScope
  url        String         @unique @db.Text
  label      String?        @db.VarChar(180)
  position   Int            @default(0)
  confidence DataConfidence @default(UNKNOWN)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, platform, scope])
  @@index([projectId, scope, position])
  @@map("platform_links")
}

model Credit {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String?        @db.Uuid
  trackId    String?        @db.Uuid
  name       String         @db.VarChar(180)
  role       CreditRole
  note       String?        @db.Text
  position   Int            @default(0)
  confidence DataConfidence @default(UNKNOWN)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  track      Track?         @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([projectId, position])
  @@index([trackId, position])
  @@map("credits")
}

model ConfidenceAnnotation {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  domain       ConfidenceDomain
  level        DataConfidence
  source       String?          @db.VarChar(500)
  note         String?          @db.Text
  verifiedAt   DateTime?        @db.Timestamptz(3)
  verifiedById String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  verifiedBy   User?            @relation("ConfidenceReviewer", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([projectId, domain])
  @@index([verifiedById])
  @@map("confidence_annotations")
}

model Asset {
  id                String              @id @default(uuid()) @db.Uuid
  type              AssetType
  storageKey        String              @unique @db.VarChar(500)
  storageBackend    MediaStorageBackend @default(LOCAL)
  storageProvider   String              @default("local") @db.VarChar(80)
  visibility        MediaVisibility     @default(PRIVATE)
  checksumSha256    String?             @db.VarChar(64)
  filename          String              @db.VarChar(255)
  mimeType          String              @db.VarChar(160)
  sizeBytes         BigInt
  width             Int?
  height            Int?
  durationMs        Int?                @map("duration_ms")
  alt               String?             @db.VarChar(500)
  rightsStatus      RightsStatus        @default(UNKNOWN)
  rightsNote        String?             @db.Text
  confidence        DataConfidence      @default(UNKNOWN)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  projects          ProjectAsset[]
  orders            OrderAsset[]
  contractDocuments ContractDocument[]

  @@index([type, rightsStatus])
  @@index([storageBackend, visibility])
  @@map("assets")
}

model ProjectAsset {
  projectId String           @db.Uuid
  assetId   String           @db.Uuid
  role      ProjectAssetRole
  position  Int              @default(0)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([projectId, assetId, role])
  @@index([projectId, role, position])
  @@index([assetId])
  @@map("project_assets")
}

model Order {
  id                         String              @id @default(uuid()) @db.Uuid
  orderNumber                String              @unique @db.VarChar(32)
  userId                     String?             @db.Uuid
  customerId                 String?             @db.Uuid
  customerEmail              String              @db.VarChar(320)
  customerName               String?             @db.VarChar(200)
  status                     OrderStatus         @default(DRAFT)
  title                      String?             @db.VarChar(240)
  recipient                  String?             @db.VarChar(200)
  occasion                   String?             @db.VarChar(200)
  brief                      String              @db.Text
  musicalDirection           String?             @db.Text
  emotion                    String?             @db.Text
  importantDetails           String?             @db.Text
  wordsToInclude             String?             @db.Text
  avoid                      String?             @db.Text
  pronunciationNotes         String?             @db.Text
  notes                      String?             @db.Text
  usage                      OrderUsage          @default(PERSONAL)
  coverIncluded              Boolean             @default(false)
  priorityProcessing         Boolean             @default(false)
  basePriceCents             Int                 @default(5000)
  coverPriceCents            Int                 @default(0)
  priorityPriceCents         Int                 @default(0)
  totalCents                 Int                 @default(5000)
  currency                   String              @default("EUR") @db.VarChar(3)
  pricingVersion             String              @default("2026-08-v1") @db.VarChar(32)
  personalUseTermsVersion    String?             @db.VarChar(48)
  personalUseTermsHashSha256 String?             @db.VarChar(64)
  personalUseTermsAcceptedAt DateTime?           @db.Timestamptz(3)
  contractRequired           Boolean             @default(false)
  revisionAllowance          Int                 @default(1)
  revisionUsed               Int                 @default(0)
  submittedAt                DateTime?           @db.Timestamptz(3)
  serviceStartedAt           DateTime?           @db.Timestamptz(3)
  deliveredAt                DateTime?           @db.Timestamptz(3)
  downloadExpiresAt          DateTime?           @db.Timestamptz(3)
  cancelledAt                DateTime?           @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)
  account                    User?               @relation("OrderAccount", fields: [userId], references: [id], onDelete: SetNull)
  customer                   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events                     OrderEvent[]
  assets                     OrderAsset[]
  rightsRequests             RightsRequest[]
  commercialLicenses         CommercialLicense[]
  payments                   Payment[]
  notifications              OrderNotification[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([userId, status, updatedAt])
  @@index([customerId])
  @@map("orders")
}

model OrderNotification {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @db.Uuid
  kind                  OrderNotificationKind
  channel               NotificationChannel
  priority              NotificationPriority  @default(INFORMATIONAL)
  recipient             String?               @db.VarChar(320)
  idempotencyKey        String                @unique @db.VarChar(255)
  templateKey           String                @default("legacy-order-notification") @db.VarChar(80)
  templateVersion       Int                   @default(1)
  payloadVersion        Int                   @default(1)
  payload               Json                  @default("{}")
  resourceType          String                @default("ORDER") @db.VarChar(32)
  resourceId            String?               @db.Uuid
  resourceReference     String?               @db.VarChar(80)
  deploymentEnvironment String                @default("development") @db.VarChar(16)
  status                NotificationStatus    @default(PENDING)
  attempts              Int                   @default(0)
  availableAt           DateTime              @default(now()) @db.Timestamptz(3)
  processingStartedAt   DateTime?             @db.Timestamptz(3)
  leaseExpiresAt        DateTime?             @db.Timestamptz(3)
  sentAt                DateTime?             @db.Timestamptz(3)
  deliveredAt           DateTime?             @db.Timestamptz(3)
  failedAt              DateTime?             @db.Timestamptz(3)
  provider              NotificationProvider?
  providerMessageId     String?               @unique @db.VarChar(255)
  lastErrorCode         String?               @db.VarChar(80)
  lastErrorMessage      String?               @db.VarChar(240)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events                NotificationEvent[]

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([orderId, kind, channel])
  @@index([resourceType, resourceId])
  @@map("order_notifications")
}

model NotificationEvent {
  id                String                   @id @default(uuid()) @db.Uuid
  notificationId    String?                  @db.Uuid
  providerEventId   String?                  @unique @db.VarChar(255)
  providerMessageId String?                  @db.VarChar(255)
  providerEventType String?                  @db.VarChar(80)
  outcome           NotificationEventOutcome
  code              String?                  @db.VarChar(80)
  actorUserId       String?                  @db.Uuid
  occurredAt        DateTime                 @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  notification      OrderNotification?       @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  actor             User?                    @relation("NotificationEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([notificationId, createdAt])
  @@index([providerMessageId, occurredAt])
  @@index([outcome, createdAt])
  @@map("notification_events")
}

model NotificationSuppression {
  id                  String                        @id @default(uuid()) @db.Uuid
  channel             NotificationChannel
  recipient           String                        @db.VarChar(320)
  recipientHashSha256 String                        @db.Char(64)
  reason              NotificationSuppressionReason
  provider            NotificationProvider?
  active              Boolean                       @default(true)
  sourceEventId       String?                       @db.VarChar(255)
  lastEventAt         DateTime                      @db.Timestamptz(3)
  removedAt           DateTime?                     @db.Timestamptz(3)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(3)

  @@unique([channel, recipient])
  @@unique([channel, recipientHashSha256])
  @@index([active, reason, updatedAt])
  @@map("notification_suppressions")
}

model Payment {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @db.Uuid
  provider            PaymentProvider @default(STRIPE)
  mode                PaymentMode
  status              PaymentStatus   @default(CREATED)
  amountCents         Int
  currency            String          @db.VarChar(3)
  pricingVersion      String          @db.VarChar(32)
  idempotencyKey      String          @unique @db.VarChar(255)
  providerCheckoutId  String?         @db.VarChar(255)
  providerPaymentId   String?         @db.VarChar(255)
  paymentMethod       PaymentMethod?
  failureCode         String?         @db.VarChar(120)
  checkoutExpiresAt   DateTime?       @db.Timestamptz(3)
  paidAt              DateTime?       @db.Timestamptz(3)
  failedAt            DateTime?       @db.Timestamptz(3)
  canceledAt          DateTime?       @db.Timestamptz(3)
  expiredAt           DateTime?       @db.Timestamptz(3)
  refundedAt          DateTime?       @db.Timestamptz(3)
  refundedAmountCents Int             @default(0)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events              ProviderEvent[]

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([provider, mode, status, updatedAt])
  @@map("payments")
}

model ProviderEvent {
