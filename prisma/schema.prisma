model User {
  id                                 String                        @id @default(uuid()) @db.Uuid
  email                              String                        @unique @db.VarChar(320)
  emailVerified                      Boolean                       @default(false)
  emailVerifiedAt                    DateTime?                     @db.Timestamptz(3)
  displayName                        String                        @default("") @db.VarChar(120)
  firstName                          String?                       @db.VarChar(100)
  lastName                           String?                       @db.VarChar(100)
  image                              String?                       @db.VarChar(500)
  role                               UserRole                      @default(MEMBER)
  status                             UserStatus                    @default(PENDING)
  createdAt                          DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                      @updatedAt @db.Timestamptz(3)
  customerProfile                    Customer?
  orders                             Order[]                       @relation("OrderAccount")
  orderEvents                        OrderEvent[]                  @relation("OrderEventActor")
  confidenceReviews                  ConfidenceAnnotation[]        @relation("ConfidenceReviewer")
  favorites                          Favorite[]
  sessions                           Session[]
  accounts                           Account[]
  rightsRequests                     RightsRequest[]               @relation("RightsRequestOwner")
  partyConfirmations                 ContractPartySnapshot[]       @relation("ContractPartyConfirmedBy")
  rightsEvents                       RightsRequestEvent[]          @relation("RightsEventActor")
  rightsMessages                     RightsMessage[]               @relation("RightsMessageAuthor")
  templateApprovals                  ContractTemplate[]            @relation("ContractTemplateApprover")
  contractAcceptances                ContractAcceptance[]          @relation("ContractAcceptanceActor")
  splitProposals                     RightsSplitProposal[]         @relation("RightsSplitProposer")
  notificationEvents                 NotificationEvent[]           @relation("NotificationEventActor")
  refundRequests                     RefundAttempt[]               @relation("RefundRequestedBy")
  paymentAuditEvents                 PaymentAuditEvent[]           @relation("PaymentAuditActor")
  pricingVersionsCreated             MusicPricingVersion[]         @relation("MusicPricingVersionCreatedBy")
  pricingConfigurationsUpdated       MusicPricingConfiguration[]   @relation("MusicPricingConfigurationUpdatedBy")
  pricingActivations                 MusicPricingActivation[]      @relation("MusicPricingActivationActor")
  productsCreated                    Product[]                     @relation("ProductCreatedBy")
  productsUpdated                    Product[]                     @relation("ProductUpdatedBy")
  productStockAdjustments            ProductStockAdjustment[]      @relation("ProductStockAdjustmentActor")
  productAuditEvents                 ProductAuditEvent[]           @relation("ProductAuditEventActor")
  shopOrders                         ShopOrder[]                   @relation("ShopOrderOwner")
  shopOrderEvents                    ShopOrderEvent[]              @relation("ShopOrderEventActor")
  shopOrderLifecycleEvents           ShopOrderLifecycleEvent[]     @relation("ShopOrderLifecycleEventActor")
  shippingProviderAttemptsCreated    ShopShippingProviderAttempt[] @relation("ShopShippingProviderAttemptCreatedBy")
  shippingProviderAttemptsReconciled ShopShippingProviderAttempt[] @relation("ShopShippingProviderAttemptReconciledBy")
  legalDocumentApprovals             LegalDocumentVersion[]        @relation("LegalDocumentApprover")
  withdrawalReviews                  ConsumerWithdrawalRequest[]   @relation("ConsumerWithdrawalReviewer")
  billingAuditEvents                 BillingAuditEvent[]           @relation("BillingAuditActor")
  shopReturnRequests                 ShopReturnRequest[]           @relation("ShopReturnOwner")
  shopReturnReviews                  ShopReturnRequest[]           @relation("ShopReturnReviewer")
  shopReturnAuditEvents              ShopReturnAuditEvent[]        @relation("ShopReturnAuditActor")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(120)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(500)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @unique @db.VarChar(320)
  value      String   @db.VarChar(500)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model RegistrationAttempt {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @db.VarChar(320)
  codeHash              String    @db.VarChar(128)
  expiresAt             DateTime  @db.Timestamptz(3)
  failedAttempts        Int       @default(0)
  resendCount           Int       @default(0)
  verifiedAt            DateTime? @db.Timestamptz(3)
  consumedAt            DateTime? @db.Timestamptz(3)
  continuationHash      String?   @db.VarChar(128)
  continuationExpiresAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([continuationExpiresAt])
  @@map("auth_registration_attempts")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @db.Uuid
  email       String   @unique @db.VarChar(320)
  displayName String?  @db.VarChar(120)
  firstName   String?  @db.VarChar(100)
  lastName    String?  @db.VarChar(100)
  phone       String?  @db.VarChar(40)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([createdAt])
  @@map("customers")
}

model Project {
  id                    String                   @id @default(uuid()) @db.Uuid
  slug                  String                   @unique @db.VarChar(160)
  title                 String                   @db.VarChar(240)
  subtitle              String?                  @db.VarChar(240)
  type                  ProjectType
  status                ProjectStatus            @default(DRAFT)
  publicVisible         Boolean                  @default(true)
  jukeboxPlacement      ProjectJukeboxPlacement?
  jukeboxPosition       Int?
  catalogPosition       Int                      @unique
  highlighted           Boolean                  @default(false)
  shortDescription      String?                  @db.Text
  description           String?                  @db.Text
  releaseDate           DateTime?                @db.Date
  featured              Boolean                  @default(false)
  trackCount            Int?
  artworkTone           String                   @default("graphite") @db.VarChar(32)
  seoTitle              String?                  @db.VarChar(240)
  seoDescription        String?                  @db.Text
  legacySourceVersion   String?                  @db.VarChar(80)
  confidence            DataConfidence           @default(UNKNOWN)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  tracks                Track[]
  platformLinks         PlatformLink[]
  credits               Credit[]
  confidenceAnnotations ConfidenceAnnotation[]
  assets                ProjectAsset[]
  favorites             Favorite[]

  @@index([status, featured])
  @@index([type, status])
  @@index([publicVisible, status, catalogPosition])
  @@index([publicVisible, jukeboxPlacement, jukeboxPosition, catalogPosition])
  @@map("projects")
}

model Track {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  position        Int
  title           String         @db.VarChar(240)
  durationSeconds Int?
  status          TrackStatus    @default(DRAFT)
  confidence      DataConfidence @default(UNKNOWN)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  credits         Credit[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("tracks")
}

model PlatformLink {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String?        @db.Uuid
  platform   Platform
  scope      PlatformScope
  url        String         @unique @db.Text
  label      String?        @db.VarChar(180)
  position   Int            @default(0)
  confidence DataConfidence @default(UNKNOWN)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, platform, scope])
  @@index([projectId, scope, position])
  @@map("platform_links")
}

