  @@index([paymentId, createdAt])
  @@index([provider, livemode, createdAt])
  @@map("provider_events")
}

model RightsRequest {
  id                        String                   @id @default(uuid()) @db.Uuid
  requestNumber             String                   @unique @db.VarChar(32)
  orderId                   String                   @db.Uuid
  userId                    String                   @db.Uuid
  type                      RightsRequestType
  status                    RightsRequestStatus      @default(DRAFT)
  requestedPriceCents       Int
  currency                  String                   @default("EUR") @db.VarChar(3)
  pricingVersion            String                   @db.VarChar(48)
  workTitle                 String                   @db.VarChar(240)
  artistName                String?                  @db.VarChar(180)
  formVersion               String                   @db.VarChar(48)
  formData                  Json
  aiAssessment              AiContributionAssessment @default(NOT_REVIEWED)
  submittedAt               DateTime?                @db.Timestamptz(3)
  reviewedAt                DateTime?                @db.Timestamptz(3)
  approvedAt                DateTime?                @db.Timestamptz(3)
  rejectedAt                DateTime?                @db.Timestamptz(3)
  cancelledAt               DateTime?                @db.Timestamptz(3)
  rejectionReason           String?                  @db.Text
  needsInformationMessage   String?                  @db.Text
  legacyCommercialLicenseId String?                  @unique @db.Uuid
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(3)
  order                     Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  owner                     User                     @relation("RightsRequestOwner", fields: [userId], references: [id], onDelete: Restrict)
  partySnapshots            ContractPartySnapshot[]
  contributions             RightsContribution[]
  grants                    RightsGrant[]
  splitProposals            RightsSplitProposal[]
  events                    RightsRequestEvent[]
  messages                  RightsMessage[]
  documents                 ContractDocument[]

  @@index([orderId, createdAt])
  @@index([userId, updatedAt])
  @@index([type, status, updatedAt])
  @@map("rights_requests")
}

model ContractPartySnapshot {
  id                  String            @id @default(uuid()) @db.Uuid
  rightsRequestId     String            @db.Uuid
  version             Int
  partyType           ContractPartyType
  firstName           String?           @db.VarChar(100)
