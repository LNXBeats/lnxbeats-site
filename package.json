{
  "name": "lnx-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:auth": "tsx --test tests/auth/*.test.ts",
    "test:auth:runtime": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-auth-runtime.ts",
    "test:registration:runtime": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-registration-runtime.ts",
    "auth:qa:fixtures": "NODE_OPTIONS=--conditions=react-server tsx scripts/auth-qa-fixtures.ts",
    "auth:admin:bootstrap": "NODE_OPTIONS=--conditions=react-server tsx scripts/bootstrap-admin.ts",
    "test:order": "NODE_OPTIONS=--conditions=react-server tsx --test tests/orders/domain.test.ts tests/orders/request.test.ts",
    "test:rights": "NODE_OPTIONS=--conditions=react-server tsx --test tests/orders/rights.test.ts",
    "test:upload": "tsx --test tests/orders/upload.test.ts",
    "test:order:runtime": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-order-runtime.ts",
    "test:admin": "NODE_OPTIONS=--conditions=react-server tsx --test tests/admin/*.test.ts",
    "test:admin:runtime": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-admin-runtime.ts",
    "catalog:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/catalog-migrate.ts",
    "catalog:migrate:dry-run": "NODE_OPTIONS=--conditions=react-server tsx scripts/catalog-migrate.ts --dry-run",
    "catalog:compare": "NODE_OPTIONS=--conditions=react-server tsx scripts/catalog-compare.ts",
    "test:catalog": "NODE_OPTIONS=--conditions=react-server tsx --test tests/catalog/*.test.ts",
    "test:catalog:runtime": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-catalog-runtime.ts",
    "test:catalog:http": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-catalog-cover-http.ts",
    "catalog:cover:browser-fixtures": "NODE_OPTIONS=--conditions=react-server tsx scripts/catalog-cover-browser-fixtures.ts",
    "order:qa:fixtures": "NODE_OPTIONS=--conditions=react-server tsx scripts/order-qa-fixtures.ts",
    "test:database": "tsx scripts/test-database.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:check": "npm run prisma:format && npm run prisma:validate && npm run prisma:generate",
    "check": "npm run prisma:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.26",
    "dotenv": "17.4.2",
    "next": "16.3.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.19.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.16.0"
}
